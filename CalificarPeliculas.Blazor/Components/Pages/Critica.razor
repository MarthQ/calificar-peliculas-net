@page "/criticas"
@rendermode InteractiveServer
@inject CriticasApiClient Criticas
@inject ContenidosApiClient Contenidos
@inject SesionState Sesion

<PageTitle>Críticas</PageTitle>

<h3>Críticas</h3>

@if (!Sesion.EstaAutenticado)
{
    <div class="alert alert-warning">Debés <a href="/login">iniciar sesión</a> para administrar críticas.</div>
}
else if (!Sesion.EsAdmin)
{
    <div class="alert alert-danger">No tenés permisos para administrar críticas.</div>
}
else if (contenidos == null || criticas == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="row">
        <div class="col-lg-7">
            <div class="mb-3">
                <label>Contenido maestro</label>
                <select class="form-select" @bind="contenidoSeleccionadoId" @bind:after="CargarDetalle">
                    <option value="0">-- Seleccione --</option>
                    @foreach (var contenido in contenidos)
                    {
                        <option value="@contenido.Id">@contenido.Nombre (@contenido.Tipo)</option>
                    }
                </select>
            </div>

            @if (contenidoSeleccionado != null)
            {
                <h5>@contenidoSeleccionado.Nombre</h5>
                <p class="text-muted">Críticas asociadas: @criticas.Count</p>
            }

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Contenido</th>
                        <th>Calificación</th>
                        <th>Fecha</th>
                        <th>Texto</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in criticas)
                    {
                        <tr>
                            <td>@contenidoSeleccionado?.Nombre</td>
                            <td>@c.Calificacion</td>
                            <td>@c.FechaPublicacion</td>
                            <td class="texto-critica">@c.Texto</td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => Seleccionar(c)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(c)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-lg-5">
            <h5>@(editando ? "Editar crítica" : "Nueva crítica")</h5>
            <div class="mb-2">
                <label>Contenido</label>
                <input class="form-control" value="@(contenidoSeleccionado?.Nombre ?? "Seleccione un contenido")" readonly />
            </div>
            <div class="row">
                <div class="col mb-2">
                    <label>Calificación (0-10)</label>
                    <input class="form-control" type="number" step="0.5" min="0" max="10" @bind="form.Calificacion" />
                </div>
                <div class="col mb-2">
                    <label>Fecha de publicación</label>
                    <input class="form-control" type="date" @bind="fechaPublicacion" />
                </div>
            </div>
            <div class="mb-2">
                <label>Texto</label>
                <textarea class="form-control" rows="4" @bind="form.Texto"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger">@error</div>
            }

            <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
            <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
        </div>
    </div>
}

@code {
    private List<CriticaDTO>? criticas;
    private List<ContenidoDTO>? contenidos;
    private ContenidoDTO? contenidoSeleccionado;
    private int contenidoSeleccionadoId;
    private CriticaDTO form = new();
    private DateTime fechaPublicacion = DateTime.Today;
    private bool editando;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (Sesion.EstaAutenticado)
        {
            await Cargar();
        }
    }

    private async Task Cargar()
    {
        contenidos = await Contenidos.GetAllAsync();
        if (contenidos?.Count > 0)
        {
            contenidoSeleccionadoId = contenidos[0].Id;
            await CargarDetalle();
        }
        else
        {
            criticas = new List<CriticaDTO>();
        }
    }

    private async Task CargarDetalle()
    {
        if (contenidoSeleccionadoId <= 0)
        {
            contenidoSeleccionado = null;
            criticas = new List<CriticaDTO>();
            Limpiar();
            return;
        }

        var detalle = await Contenidos.GetWithCriticasAsync(contenidoSeleccionadoId);
        contenidoSeleccionado = detalle?.Contenido;
        criticas = detalle?.Criticas ?? new List<CriticaDTO>();
        Limpiar();
    }

    private void Seleccionar(CriticaDTO c)
    {
        form = new CriticaDTO
        {
            Id = c.Id,
            UsuarioId = c.UsuarioId,
            ContenidoId = c.ContenidoId,
            Texto = c.Texto,
            Calificacion = c.Calificacion,
            CantReacciones = c.CantReacciones
        };
        fechaPublicacion = c.FechaPublicacion.ToDateTime(TimeOnly.MinValue);
        editando = true;
        error = null;
    }

    private void Limpiar()
    {
        form = new CriticaDTO { ContenidoId = contenidoSeleccionadoId };
        fechaPublicacion = DateTime.Today;
        editando = false;
        error = null;
    }

    private async Task Guardar()
    {
        error = null;

        if (form.ContenidoId <= 0 || string.IsNullOrWhiteSpace(form.Texto))
        {
            error = "Seleccione un contenido y complete el texto de la crítica.";
            return;
        }

        form.FechaPublicacion = DateOnly.FromDateTime(fechaPublicacion);

        if (!editando)
        {
            form.UsuarioId = Sesion.Usuario!.Id;
            form.CantReacciones = 0;
        }

        var ok = editando ? await Criticas.UpdateAsync(form) : await Criticas.AddAsync(form);
        if (!ok)
        {
            error = "No se pudo guardar la crítica.";
            return;
        }

        Limpiar();
        await CargarDetalle();
    }

    private async Task Eliminar(CriticaDTO c)
    {
        error = null;
        if (!await Criticas.DeleteAsync(c.Id))
        {
            error = "No se pudo eliminar la crítica.";
            return;
        }
        await CargarDetalle();
    }
}
