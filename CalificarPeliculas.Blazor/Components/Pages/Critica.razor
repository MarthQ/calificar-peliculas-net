@page "/criticas"
@rendermode InteractiveServer
@inject CriticasApiClient Criticas
@inject ContenidosApiClient Contenidos
@inject SesionState Sesion

<PageTitle>Críticas</PageTitle>

<h3>Críticas</h3>

@if (!Sesion.EstaAutenticado)
{
    <div class="alert alert-warning">Debés <a href="/login">iniciar sesión</a> para administrar críticas.</div>
}
else if (criticas == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="row">
        <div class="col-lg-7">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Contenido</th>
                        <th>Calificación</th>
                        <th>Fecha</th>
                        <th>Texto</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in criticas)
                    {
                        <tr>
                            <td>@(contenidos?.FirstOrDefault(x => x.Id == c.ContenidoId)?.Nombre ?? c.ContenidoId.ToString())</td>
                            <td>@c.Calificacion</td>
                            <td>@c.FechaPublicacion</td>
                            <td class="texto-critica">@c.Texto</td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => Seleccionar(c)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(c)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-lg-5">
            <h5>@(editando ? "Editar crítica" : "Nueva crítica")</h5>
            <div class="mb-2">
                <label>Contenido</label>
                <select class="form-select" @bind="form.ContenidoId" disabled="@editando">
                    <option value="0">-- Seleccione --</option>
                    @if (contenidos != null)
                    {
                        @foreach (var c in contenidos)
                        {
                            <option value="@c.Id">@c.Nombre (@c.Tipo)</option>
                        }
                    }
                </select>
            </div>
            <div class="row">
                <div class="col mb-2">
                    <label>Calificación (0-10)</label>
                    <input class="form-control" type="number" step="0.5" min="0" max="10" @bind="form.Calificacion" />
                </div>
                <div class="col mb-2">
                    <label>Fecha de publicación</label>
                    <input class="form-control" type="date" @bind="fechaPublicacion" />
                </div>
            </div>
            <div class="mb-2">
                <label>Texto</label>
                <textarea class="form-control" rows="4" @bind="form.Texto"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger">@error</div>
            }

            <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
            <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
        </div>
    </div>
}

@code {
    private List<CriticaDTO>? criticas;
    private List<ContenidoDTO>? contenidos;
    private CriticaDTO form = new();
    private DateTime fechaPublicacion = DateTime.Today;
    private bool editando;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (Sesion.EstaAutenticado)
        {
            await Cargar();
        }
    }

    private async Task Cargar()
    {
        criticas = await Criticas.GetAllAsync();
        contenidos = await Contenidos.GetAllAsync();
    }

    private void Seleccionar(CriticaDTO c)
    {
        form = new CriticaDTO
        {
            Id = c.Id,
            UsuarioId = c.UsuarioId,
            ContenidoId = c.ContenidoId,
            Texto = c.Texto,
            Calificacion = c.Calificacion,
            CantReacciones = c.CantReacciones
        };
        fechaPublicacion = c.FechaPublicacion.ToDateTime(TimeOnly.MinValue);
        editando = true;
        error = null;
    }

    private void Limpiar()
    {
        form = new CriticaDTO();
        fechaPublicacion = DateTime.Today;
        editando = false;
        error = null;
    }

    private async Task Guardar()
    {
        error = null;

        if (form.ContenidoId <= 0 || string.IsNullOrWhiteSpace(form.Texto))
        {
            error = "Seleccione un contenido y complete el texto de la crítica.";
            return;
        }

        form.FechaPublicacion = DateOnly.FromDateTime(fechaPublicacion);

        if (!editando)
        {
            form.UsuarioId = Sesion.Usuario!.Id;
            form.CantReacciones = 0;
        }

        var ok = editando ? await Criticas.UpdateAsync(form) : await Criticas.AddAsync(form);
        if (!ok)
        {
            error = "No se pudo guardar la crítica.";
            return;
        }

        Limpiar();
        await Cargar();
    }

    private async Task Eliminar(CriticaDTO c)
    {
        error = null;
        if (!await Criticas.DeleteAsync(c.Id))
        {
            error = "No se pudo eliminar la crítica.";
            return;
        }
        await Cargar();
    }
}
