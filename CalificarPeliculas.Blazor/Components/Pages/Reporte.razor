@page "/reportes"
@rendermode InteractiveServer
@inject ReportesApiClient Reportes
@inject SesionState Sesion

<PageTitle>Reportes</PageTitle>
<h3>Reportes de contenidos</h3>

@if (!Sesion.EstaAutenticado || !Sesion.EsGestion)
{
    <div class="alert alert-danger">Se requiere una sesión de administrador o moderador.</div>
}
else if (resumen == null || detalle == null)
{
    <p>Cargando reportes...</p>
}
else
{
    <section class="mb-5">
        <h4>Reporte 1: resumen por contenido</h4>
        <p class="text-muted">Promedios de calificación y cantidades agrupadas por contenido.</p>
        <div class="border rounded p-3">
            @foreach (var item in resumen.Take(10))
            {
                var ancho = item.PromedioCalificacion * 10;
                <div class="mb-2">
                    <div class="d-flex justify-content-between"><span>@item.Contenido</span><strong>@item.PromedioCalificacion.ToString("0.00")</strong></div>
                    <svg viewBox="0 0 100 12" class="w-100" role="img" aria-label="@item.Contenido">
                        <rect x="0" y="1" width="100" height="10" fill="#e9ecef" rx="2" />
                        <rect x="0" y="1" width="@ancho" height="10" fill="#0d6efd" rx="2" />
                    </svg>
                </div>
            }
        </div>
        <table class="table table-sm mt-3"><thead><tr><th>Contenido</th><th>Género</th><th>Críticas</th><th>Comentarios</th></tr></thead><tbody>
        @foreach (var item in resumen) { <tr><td>@item.Contenido</td><td>@item.Genero</td><td>@item.CantidadCriticas</td><td>@item.CantidadComentarios</td></tr> }
        </tbody></table>
    </section>

    <section>
        <h4>Reporte 2: detalle de críticas y comentarios</h4>
        <p class="text-muted">Detalle de cada crítica, su usuario y los comentarios asociados.</p>
        <div class="table-responsive"><table class="table table-striped table-sm"><thead><tr><th>Contenido</th><th>Género</th><th>Usuario</th><th>Crítica</th><th>Calificación</th><th>Comentario</th><th>Reacción</th><th>Fecha</th></tr></thead><tbody>
        @foreach (var item in detalle) { <tr><td>@item.Contenido</td><td>@item.Genero</td><td>@item.Usuario</td><td>@item.TextoCritica</td><td>@item.Calificacion</td><td>@item.TextoComentario</td><td>@item.Reaccion</td><td>@item.FechaComentario</td></tr> }
        </tbody></table></div>
    </section>
}

@code {
    private List<ReporteContenidoDTO>? resumen;
    private List<ReporteDetalleDTO>? detalle;

    protected override async Task OnInitializedAsync()
    {
        if (Sesion.EsGestion)
        {
            resumen = await Reportes.GetResumenAsync();
            detalle = await Reportes.GetDetalleAsync();
        }
    }
}
