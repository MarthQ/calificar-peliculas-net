@page "/usuarios"
@rendermode InteractiveServer
@inject UsuariosApiClient Usuarios
@inject GruposApiClient Grupos
@inject SesionState Sesion

<PageTitle>Usuarios</PageTitle>
<h3>Usuarios</h3>

@if (!Sesion.EstaAutenticado || !Sesion.EsAdmin)
{
    <div class="alert alert-danger">Se requiere una sesión de administrador.</div>
}
else if (usuarios == null || grupos == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="row"><div class="col-lg-7"><table class="table table-striped"><thead><tr><th>Usuario</th><th>Mail</th><th>Rol</th><th>Grupo</th><th></th></tr></thead><tbody>
    @foreach (var usuario in usuarios) { <tr><td>@usuario.NombreUsuario</td><td>@usuario.Mail</td><td>@usuario.RolId</td><td>@GrupoNombre(usuario.GrupoId)</td><td><button class="btn btn-sm btn-secondary" @onclick="() => Editar(usuario)">Editar</button> <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(usuario.Id)">Eliminar</button></td></tr> }
    </tbody></table></div><div class="col-lg-5"><h5>@(editando ? "Editar usuario" : "Nuevo usuario")</h5>
    <input class="form-control mb-2" placeholder="Nombre de usuario" @bind="nombre" /><input class="form-control mb-2" type="email" placeholder="Mail" @bind="mail" />
    @if (!editando) { <input class="form-control mb-2" type="password" placeholder="Contraseña" @bind="password" /> }
    <input class="form-control mb-2" type="number" min="1" placeholder="Rol" @bind="rolId" />
    <select class="form-select mb-2" @bind="grupoId"><option value="">Sin grupo</option>@foreach (var grupo in grupos) { <option value="@grupo.Id">@grupo.Nombre</option> }</select>
    @if (error != null) { <div class="alert alert-danger">@error</div> }<button class="btn btn-primary" @onclick="Guardar">Guardar</button> <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
    </div></div>
}

@code {
    private List<UsuarioDTO>? usuarios; private List<GrupoDTO>? grupos; private int id; private string nombre = string.Empty; private string mail = string.Empty; private string password = string.Empty; private int rolId = 3; private int? grupoId; private bool editando; private string? error;
    protected override async Task OnInitializedAsync() { if (Sesion.EstaAutenticado) { usuarios = await Usuarios.GetAllAsync(); grupos = await Grupos.GetAllAsync(); } }
    private string GrupoNombre(int? id) => id.HasValue ? grupos?.FirstOrDefault(g => g.Id == id)?.Nombre ?? id.Value.ToString() : "Sin grupo";
    private void Editar(UsuarioDTO u) { id = u.Id; nombre = u.NombreUsuario; mail = u.Mail; rolId = u.RolId; grupoId = u.GrupoId; editando = true; error = null; }
    private void Limpiar() { id = 0; nombre = mail = password = string.Empty; rolId = 3; grupoId = null; editando = false; error = null; }
    private async Task Guardar() { error = null; if (string.IsNullOrWhiteSpace(nombre) || string.IsNullOrWhiteSpace(mail) || (!editando && string.IsNullOrWhiteSpace(password))) { error = "Complete los campos obligatorios."; return; } bool ok; if (editando) ok = await Usuarios.UpdateAsync(new ActualizarUsuarioDTO { Id = id, NombreUsuario = nombre, Mail = mail, RolId = rolId, GrupoId = grupoId }); else ok = await Usuarios.AddAsync(new RegistrarUsuarioDTO { NombreUsuario = nombre, Mail = mail, Password = password, RolId = rolId, GrupoId = grupoId }); if (!ok) { error = "No se pudo guardar el usuario."; return; } Limpiar(); usuarios = await Usuarios.GetAllAsync(); }
    private async Task Eliminar(int id) { if (await Usuarios.DeleteAsync(id)) usuarios = await Usuarios.GetAllAsync(); }
}
